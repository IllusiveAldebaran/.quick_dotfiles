[color]
	ui = true
	email = home@mail.com
[user]
	email = ffgutierrez@ucsd.edu
	name = francisco
[init]
	defaultBranch = master
[core]
	editor = nvim
	pager = less
	compression = 9
	whitespace = error
  preloadindex = true

#[advice]
#  addEmptyPathspec = false
#  pushNonFastForward = false
#  statusHints = false

[url "git@github.com:"]
  insteadOf = "gh:"

[status]
  branch = true
  showStash = true
  showUntrackedFiles = all

[diff]
  context = 3
  renames = copies
  interHunkContext = 10

[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f

[commit]
	template = ~/.config/git/git_commit_template

[push]
  default = current
[pull]
  default = current
  rebase = true
[rebase]
  autoStash = false
  missingCommitsCheck = warn
[log]
  autoStash = false
  missingCommitsCheck = warn
  abbrevCommit = true
  graphColors = blue,yellow,cyan,magenta,green,red
[color "decorate"]
  HEAD = red
  branch = blue
  tag = yellow
  remoteBranch = magenta
